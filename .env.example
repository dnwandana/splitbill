OPENROUTER_API_KEY=your_openrouter_api_key
COMPLETION_MODEL=qwen/qwen3-vl-8b-instruct
UMAMI_WEBSITE_ID=your_umami_website_id

# Per-IP rate limiting for /api/parse (optional; defaults shown)
# RATE_LIMIT_PER_MIN=5
# RATE_LIMIT_PER_HOUR=20

# Set to "true" ONLY when running behind a trusted reverse proxy (e.g. the
# nginx in docker-compose) so the limiter keys on the real client IP from
# X-Forwarded-For. Leave unset for direct exposure — XFF is spoofable.
# TRUST_PROXY=true
